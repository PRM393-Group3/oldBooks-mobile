th="240" height="56" as="geometry"/></mxCell><mxCell id="note" value="Nguyên tắc:&lt;br&gt;• Không chuyển tiền trực tiếp giữa người mua và người bán&lt;br&gt;• Giữ (hold) = khóa tạm, chưa trừ hẳn&lt;br&gt;• Mọi bút toán ghi sổ cái kép; số dư không bao giờ âm&lt;br&gt;• Đối soát hằng ngày&lt;br&gt;• Tiền cọc không phải doanh thu&lt;br&gt;• Rút tối thiểu 50.000 đ, admin duyệt" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFBF3;strokeColor=#DCCDB3;align=left;verticalAlign=top;spacing=12;fontSize=12;fontColor=#2A2118;" vertex="1" parent="1"><mxGeometry x="1560" y="320" width="300" height="260" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p7" name="8. Trạng thái phiên"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Sơ đồ trạng thái phiên đấu giá" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#2A2118;align=left;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="900" height="40" as="geometry"/></mxCell><mxCell id="init" value="Bắt đầu" style="ellipse;html=1;fillColor=#2A2118;strokeColor=#2A2118;fontColor=#F7F1E6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="300" width="120" height="50" as="geometry"/></mxCell><mxCell id="wait_in" value="Chờ nhận hàng" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#F3EEE4;strokeColor=#6E5F4E;fontSize=14;fontStyle=1;fontColor=#2A2118;" vertex="1" parent="1"><mxGeometry x="200" y="290" width="200" height="70" as="geometry"/></mxCell><mxCell id="review" value="Chờ duyệt" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#F3EEE4;strokeColor=#6E5F4E;fontSize=14;fontStyle=1;fontColor=#2A2118;" vertex="1" parent="1"><mxGeometry x="480" y="290" width="200" height="70" as="geometry"/></mxCell><mxCell id="reg" value="Chờ đăng ký" style="rounded=1;whi