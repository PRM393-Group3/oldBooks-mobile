i" style="swimlane;html=1;startSize=40;fontSize=16;fontStyle=1;fillColor=#DDEFEA;strokeColor=#1F6660;swimlaneFillColor=#FFFDF8;fontColor=#2A2118;" vertex="1" parent="1"><mxGeometry x="900" y="60" width="300" height="2160" as="geometry"/></mxCell><mxCell id="s" value="Bắt đầu" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2A2118;strokeColor=#2A2118;fontColor=#F7F1E6;fontSize=13;fontStyle=1;" vertex="1" parent="lane_seller"><mxGeometry x="50.0" y="78.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="a1" value="Tạo phiên: giá khởi điểm, bước nhảy, thời lượng, giá mua ngay (tuỳ chọn), ảnh" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FCE8D8;strokeColor=#A9471F;fontSize=13;fontColor=#2A2118;" vertex="1" parent="lane_seller"><mxGeometry x="30.0" y="205.0" width="240" height="90" as="geometry"/></mxCell><mxCell id="a2" value="Kiểm tra tham số; phiên = Chờ nhận hàng" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F3EEE4;strokeColor=#6E5F4E;fontSize=13;fontColor=#2A2118;" vertex="1" parent="lane_sys"><mxGeometry x="30.0" y="345.0" width="240" height="90" as="geometry"/></mxCell><mxCell id="a3" value="Gửi sách về kho Oldbook" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FCE8D8;strokeColor=#A9471F;fontSize=13;fontColor=#2A2118;" vertex="1" parent="lane_seller"><mxGeometry x="30.0" y="485.0" width="240" height="90" as="geometry"/></mxCell><mxCell id="d1" value="Sách về kho trong 5 ngày?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#B08900;fontSize=13;fontColor=#2A2118;" vertex="1" parent="lane_sys"><mxGeometry x="40.0" y="610.0" width="220" height="120" as="geometry"/></mxCell><mxCell id="eX" value="Phiên tự hủy (quá hạn)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2A2118;strokeColor=#2A2118;fontColor=#F7F1E6;fontSize=13;fontStyle=1;" vertex="1" parent="lane_seller"><mxGeometry x="50.0" y="638.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="a4" value="Nhập kho, chụp ảnh