"240" height="30" as="geometry"/></mxCell><mxCell id="leg0" value="Bắt đầu / kết thúc" style="ellipse;html=1;fillColor=#2A2118;strokeColor=#2A2118;fontColor=#F7F1E6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="100" width="240" height="56" as="geometry"/></mxCell><mxCell id="leg1" value="Quyết định" style="rhombus;html=1;fillColor=#FFF4CC;strokeColor=#B08900;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="170" width="240" height="56" as="geometry"/></mxCell><mxCell id="leg2" value="Bước xử lý (màu theo vai trò)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EEE4;strokeColor=#6E5F4E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="240" width="240" height="56" as="geometry"/></mxCell><mxCell id="note" value="Quy tắc:&lt;br&gt;• Trả giá tới đâu, giữ tiền tới đó: chỉ người dẫn đầu bị giữ tiền theo giá&lt;br&gt;• Người bị vượt được nhả tiền ngay, cọc giữ đến hết phiên&lt;br&gt;• Người bán không được trả giá phiên của mình&lt;br&gt;• Lượt trả giá xử lý tuần tự theo phiên, theo giờ máy chủ&lt;br&gt;• Giá mới đến người chơi trong ≤ 1 giây&lt;br&gt;• Trả giá trong 2 phút cuối: cộng 2 phút" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFBF3;strokeColor=#DCCDB3;align=left;verticalAlign=top;spacing=12;fontSize=12;fontColor=#2A2118;" vertex="1" parent="1"><mxGeometry x="660" y="320" width="300" height="260" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="4. Mua ngay"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Luồng 4 · Mua ngay với đếm ngược 30 phút" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#2A2118;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1200" height="40" as="geometry"/></mxCell><mxCell id="lane_player" value="Người 