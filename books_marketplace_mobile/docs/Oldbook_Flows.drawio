gt;• Chỉ người đã đăng ký phiên được bấm&lt;br&gt;• Nút ẩn khi giá hiện tại ≥ giá mua ngay&lt;br&gt;• Đếm ngược 30 phút; mỗi giá cao hơn reset về 30 phút&lt;br&gt;• Tối đa 24 giờ kể từ lúc bấm, kể cả khi thời gian phiên gốc còn dài hơn&lt;br&gt;• Giá cao hơn tính theo bước nhảy gốc, từ giá mua ngay" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFBF3;strokeColor=#DCCDB3;align=left;verticalAlign=top;spacing=12;fontSize=12;fontColor=#2A2118;" vertex="1" parent="1"><mxGeometry x="660" y="320" width="300" height="260" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="5. Giao hàng đấu giá"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Luồng 5 · Giao hàng sau phiên đấu giá" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#2A2118;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1200" height="40" as="geometry"/></mxCell><mxCell id="lane_sys" value="Hệ thống" style="swimlane;html=1;startSize=40;fontSize=16;fontStyle=1;fillColor=#F3EEE4;strokeColor=#6E5F4E;swimlaneFillColor=#FFFDF8;fontColor=#2A2118;" vertex="1" parent="1"><mxGeometry x="0" y="60" width="300" height="1460" as="geometry"/></mxCell><mxCell id="lane_kho" value="Kho / Admin vận hành" style="swimlane;html=1;startSize=40;fontSize=16;fontStyle=1;fillColor=#E3ECF7;strokeColor=#3B6EA5;swimlaneFillColor=#FFFDF8;fontColor=#2A2118;" vertex="1" parent="1"><mxGeometry x="300" y="60" width="300" height="1460" as="geometry"/></mxCell><mxCell id="lane_winner" value="Người thắng" style="swimlane;html=1;startSize=40;fontSize=16;fontStyle=1;fillColor=#DDEFEA;strokeColor=#1F6660;swimlaneFillColor=#FFFDF8;fontColor=#2A2118;" vertex="1" parent="1"><mxGeometry x="600" y="60" width="300" height="1460" as="geometry"/></mxCell><mxCell 