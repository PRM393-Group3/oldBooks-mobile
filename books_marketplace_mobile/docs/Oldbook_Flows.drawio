ời)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DDEFEA;strokeColor=#1F6660;fontSize=13;fontColor=#2A2118;" vertex="1" parent="lane_player"><mxGeometry x="30.0" y="1325.0" width="240" height="90" as="geometry"/></mxCell><mxCell id="d5" value="Hết giờ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#B08900;fontSize=13;fontColor=#2A2118;" vertex="1" parent="lane_sys"><mxGeometry x="40.0" y="1450.0" width="220" height="120" as="geometry"/></mxCell><mxCell id="e" value="Kết thúc: giá cao nhất thắng → Luồng 5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2A2118;strokeColor=#2A2118;fontColor=#F7F1E6;fontSize=13;fontStyle=1;" vertex="1" parent="lane_sys"><mxGeometry x="50.0" y="1618.0" width="200" height="64" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5C4D3E;strokeWidth=1.5;fontSize=12;fontColor=#2A2118;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5C4D3E;strokeWidth=1.5;fontSize=12;fontColor=#2A2118;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b1" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5C4D3E;strokeWidth=1.5;fontSize=12;fontColor=#2A2118;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d1" target="rej"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5C4D3E;strokeWidth=1.5;fontSize=12;fontColor=#2A2118;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="Không" style="